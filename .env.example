## Copy this to .env and edit values as needed
# Git repository (SSH or HTTPS). For SSH cloning ensure the container/pod has your SSH key.
GIT_REPO=git@github.com:P-Panda1/audio-filler.git

# Host path to your GCP service account JSON (on the runpod host). This will be mounted into the container.
SERVICE_ACCOUNT_HOST_PATH=~/google-account

# Path inside the container where the service account will be mounted (must match what's used in container runs)
SERVICE_ACCOUNT_CONTAINER_PATH=/root/google-account

# GCS bucket (full gs:// URL) containing the audio data
GCS_BUCKET=gs://your-bucket

# Runpod container image to use
RUNPOD_IMAGE=runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

# Where the workspace is mounted on the runpod host
WORKSPACE_MOUNT=/workspace

# Directory under workspace where the repo will be cloned
GIT_CLONE_DIR=/workspace/audio-filler

# mlflow port on host
MLFLOW_PORT=5000
# Local path on host to persist mlruns
MLFLOW_MOUNT_DIR=/workspace/mlruns

# Training params
CONFIGS="default large_model large_encoder large_decoder"
EPOCHS=50
BATCH_SIZE=32
RUN_LOCAL_MLFLOW=true
